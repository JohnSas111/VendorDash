# Copy this file to .env in your project root and fill in real values.
# This file (.env) stays on YOUR machine only — never commit it to git.

# From Supabase dashboard: Project settings → API
EXPO_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note: PayMongo keys do NOT go in this file.
# They go into Supabase's server-side secrets instead — see README.md
# under "Setting up PayMongo" for exactly where.
